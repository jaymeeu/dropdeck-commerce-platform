# DropDeck Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# DATABASE (Aurora PostgreSQL)
# ============================================================================
# Get these from your Vercel Aurora integration or AWS Console

AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-role
PGHOST=aurora-db.xxxxx.us-east-1.rds.amazonaws.com
PGUSER=postgres
PGDATABASE=dropdeck

# ============================================================================
# AUTHENTICATION (NextAuth.js)
# ============================================================================
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# ============================================================================
# STRIPE PAYMENTS
# ============================================================================
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Switch to live keys for production (sk_live_... / pk_live_...)

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Public key (used in client-side code)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ============================================================================
# PLATFORM CONFIGURATION
# ============================================================================

# Platform fee as percentage of order (used for future revenue tracking)
PLATFORM_FEE_PERCENT=5

# How long a reservation is valid before expiring (in seconds)
# After expiry, stock is automatically freed for other buyers
RESERVATION_TIMEOUT_SECONDS=300

# Maximum number of units a single buyer can purchase per drop
MAX_UNITS_PER_BUYER=5

# ============================================================================
# OPTIONAL: APPLICATION URL
# ============================================================================
# Used for email links, API callbacks, etc.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: NEXT.js CONFIGURATION
# ============================================================================

NODE_ENV=development

# ============================================================================
# NOTES
# ============================================================================
#
# Local Development:
# 1. Copy this file to .env.local
# 2. Fill in your Aurora connection details
# 3. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 4. Get Stripe test keys from https://dashboard.stripe.com/test/apikeys
# 5. Run: pnpm dev
#
# Production (Vercel):
# 1. Add these variables in Vercel Project Settings → Environment Variables
# 2. Use Stripe LIVE keys (sk_live_..., pk_live_...)
# 3. Generate new NEXTAUTH_SECRET for production
# 4. Set NEXTAUTH_URL to your production domain
# 5. Configure Stripe webhook endpoint in Stripe dashboard
#
# Testing:
# 1. Use test Stripe card: 4242 4242 4242 4242
# 2. Test seed data has:
#    - Seller: seller1@example.com / password123
#    - Buyer: buyer1@example.com / password123
#    - Admin: admin@example.com / password123
#
